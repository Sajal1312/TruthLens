{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truthlens:schema:annotator-record:v1",
  "title": "TruthLens independent annotator record",
  "description": "One annotator's independent labels for one claim and its evidence bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "annotator_id", "claim_verdict", "claim_rationale", "annotation_confidence", "evidence_annotations", "annotation_notes"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "annotator_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "claim_verdict": {"enum": ["SUPPORTED", "CONTRADICTED", "INCONCLUSIVE"]},
    "claim_rationale": {"type": "string", "minLength": 1},
    "annotation_confidence": {"type": "integer", "minimum": 1, "maximum": 5},
    "evidence_annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "relevance", "stance", "stance_rationale", "confidence", "notes"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
          "relevance": {"enum": ["relevant", "weakly_related", "unrelated"]},
          "stance": {"enum": ["SUPPORTS", "CONTRADICTS", "NOT ENOUGH INFORMATION"]},
          "stance_rationale": {"type": "string", "minLength": 1},
          "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
          "notes": {"type": "string"}
        }
      }
    },
    "annotation_notes": {"type": "string"}
  }
}
