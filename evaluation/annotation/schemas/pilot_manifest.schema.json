{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truthlens:schema:pilot-manifest:v1",
  "title": "TruthLens 90-claim pilot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["pilot_id", "status", "target_claim_count", "target_verdict_distribution", "challenge_categories", "claim_records_file", "annotator_submission_files", "adjudications_file", "assignment_policy"],
  "properties": {
    "pilot_id": {"const": "truthlens-independent-annotation-pilot-v1"},
    "status": {"enum": ["unpopulated", "collecting", "ready"]},
    "target_claim_count": {"const": 90},
    "target_verdict_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SUPPORTED", "CONTRADICTED", "INCONCLUSIVE"],
      "properties": {
        "SUPPORTED": {"const": 30},
        "CONTRADICTED": {"const": 30},
        "INCONCLUSIVE": {"const": 30}
      }
    },
    "challenge_categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["quantifier_scope", "direct_negation", "double_negation", "partial_negation", "numerical", "event_vs_publication_date", "future_intent_vs_event", "compound_claim", "conflicting_evidence", "insufficient_evidence", "ordinary_control"]}
    },
    "claim_records_file": {"const": "claim_records.json"},
    "annotator_submission_files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotator_1", "annotator_2"],
      "properties": {
        "annotator_1": {"const": "submissions/annotator_1.json"},
        "annotator_2": {"const": "submissions/annotator_2.json"}
      }
    },
    "adjudications_file": {"const": "adjudications.json"},
    "assignment_policy": {"const": "assign_identical_claim_ids_to_both_annotators"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ready"}}},
      "then": {"properties": {"target_claim_count": {"const": 90}}
      }
    }
  ]
}
